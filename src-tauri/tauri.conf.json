{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daymark",
  "version": "0.1.6",
  "identifier": "com.daymark.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Daymark",
        "width": 1360,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "create": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true
      },
      {
        "label": "today-widget",
        "title": "Daymark · Panel Hari Ini",
        "url": "index.html?window=today-widget",
        "width": 220,
        "height": 36,
        "minWidth": 180,
        "minHeight": 30,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "noRedirectionBitmap": true,
        "resizable": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' http://localhost:5173; connect-src ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "A quiet workspace for the day",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
